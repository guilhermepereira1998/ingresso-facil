<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.2"
        android:background="#000000">

        <ImageView
            android:id="@+id/ivScreenshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <com.wildrift.aicoach.ui.RoiOverlayView
            android:id="@+id/roiOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Depuração Visual ROI"
                android:textColor="@color/gold_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPickScreenshot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="1. Carregar Print"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Deslocamento Safe-Area (Notch X):"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekNotchOffset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="20" />

            <Button
                android:id="@+id/btnRunOcrTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/hextech_blue"
                android:text="2. Testar OCR + TFLite"
                android:textColor="@color/bg_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSaveRoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salvar Calibração"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOcrDebugResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="Carregue um print da partida. Arraste as áreas para mover; arraste o canto inferior direito para redimensionar. Depois teste o OCR e salve."
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
